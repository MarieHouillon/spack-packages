+
+template <typename Factory, typename = void>
+struct has_with_zero_guess : std::false_type {};
+
+template <typename Factory>
+struct has_with_zero_guess<
+    Factory,
+    void_t<decltype(std::declval<Factory&>().with_zero_guess(std::declval<bool>()))>>
+    : std::true_type {};
+
+template <typename Factory>
+inline void set_zero_guess_impl(Factory& f, bool v, std::true_type)
+{
+    f.with_zero_guess(v);
+}
+
+template <typename Factory>
+inline void set_zero_guess_impl(Factory&, bool, std::false_type)
+{
+    // not supported by this Ginkgo -> ignore
+}
+
+template <typename Factory>
+inline void set_zero_guess_if_supported(Factory& f, bool v)
+{
+    set_zero_guess_impl(f, v, has_with_zero_guess<Factory>{});
+}
+
